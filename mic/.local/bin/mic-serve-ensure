#!/bin/bash
# agent-host に ssh でつないだときに ~/.ssh/config の LocalCommand から呼ばれ、
# agy の声の会話のために Mac のマイクとスピーカーを渡す `agy mic-serve`（127.0.0.1:4713）が
# 動いていなければ裏で立てる。LocalCommand は同期で走るので、待たずに戻る。
log="$HOME/Library/Logs/agy-mic-serve.log"
mkdir -p "${log%/*}"
nc -z 127.0.0.1 4713 2>/dev/null && exit 0
agy=$(PATH="$HOME/.local/share/mise/shims:$PATH" command -v agy) || { echo "$(date '+%F %T') mic-serve-ensure: agy が見つからない" >>"$log"; exit 0; }
echo "$(date '+%F %T') mic-serve-ensure: $agy mic-serve を立てる" >>"$log"
nohup "$agy" mic-serve >>"$log" 2>&1 </dev/null &
exit 0
