Include config.local

Host *
    ControlMaster auto
    ControlPath ~/.ssh/cm/%C
    ControlPersist 10m
    ServerAliveInterval 60

# agent-host の agy の声の会話に、この Mac のマイクとスピーカーを渡す。
# つないだときに agy mic-serve（127.0.0.1:4713）を立て、agent-host の 24713 番に転送する。
# 同じ転送を持つ接続がすでにあれば、2 本目は警告を出して転送なしでつながる。
Host agent-host
    RemoteForward 24713 127.0.0.1:4713
    PermitLocalCommand yes
    LocalCommand ~/.local/bin/mic-serve-ensure
